FROM apache/nifi:1.19.0

USER root

# Install Python and pip
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list /etc/apt/sources.list.d/*.list 2>/dev/null || true \
 && apt-get -o Acquire::Retries=5 update \
 && apt-get install -y python3 python3-pip


# Install required Python libraries (pinned; the build context is deployment/)
COPY nifi/requirements.txt /tmp/nifi-requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/nifi-requirements.txt

USER nifi
